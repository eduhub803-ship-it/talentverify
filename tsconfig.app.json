{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./src/*"]
    },
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /*
   * Legacy Next.js/Radix scaffolding that is not part of the TalentVerify Vite
   * application. Verified disconnected in both directions: no active-app module
   * imports it, and it imports no active-app module. `src/app/router.tsx` and
   * `src/app/App.tsx` ARE active and stay typechecked.
   */
  "exclude": [
    "src/app/(public)",
    "src/app/api",
    "src/app/layout.tsx",
    "src/components",
    "src/infrastructure",
    "src/modules",
    "src/shared"
  ]
}
